# Zufaelliger Schluessel fuer die Sitzungs-Cookies.
# Erzeugen mit:  npx auth secret     (oder irgendeine lange zufaellige Zeichenkette)
AUTH_SECRET=

# Discord Developer Portal -> OAuth2
# Redirect-URL dort eintragen:
#   lokal      http://localhost:3000/api/auth/callback/discord
#   auf Vercel https://DEINE-DOMAIN.vercel.app/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Supabase: Connect -> Direct connection string -> Transaction pooler.
# Fuer dieses Projekt ist das:
#   postgresql://postgres.yzbphovtcwecerrlsqmh:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# PASSWORT ist das Datenbank-Passwort von der Projekterstellung. Supabase zeigt
# es nachtraeglich nicht mehr an - notfalls unter Database -> Settings neu setzen.
DATABASE_URL=

# Nur Mitglieder dieses Discord-Servers duerfen sich einloggen.
# Leer lassen = jeder mit Discord-Account kommt rein.
DISCORD_GUILD_ID=

# Discord-IDs, die ins Dashboard duerfen (Komma-getrennt) - normalerweise nur
# der Gildenleader. Alle anderen sehen "Kein Zutritt" und pflegen ihre Waffen
# im Discord mit /waffen.
# ACHTUNG: leer lassen heisst "jeder darf rein" - fuer die Produktion also
# unbedingt ausfuellen.
OFFICER_IDS=
