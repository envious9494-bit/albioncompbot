# Discord Developer Portal -> deine App -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional. Leer lassen = der Bot registriert seine Befehle auf jedem Server,
# auf dem er ist. Angegeben = nur dort.
DISCORD_GUILD_ID=

# Supabase: Connect -> Direct connection string -> Transaction pooler.
# Fuer dieses Projekt ist das:
#   postgresql://postgres.DEIN-PROJEKT-REF:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Adresse des Dashboards, lokal http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Betreiber des Bots - gilt auf ALLEN Servern (Komma-getrennt).
# Offiziere einzelner Server werden im Dashboard unter "Zugang"
# freigeschaltet; zusaetzlich kommt automatisch rein, wer auf dem
# Discord-Server "Server verwalten" darf.
# OFFICER_IDS wird nicht mehr benutzt: Rechte gelten je Server.
# Wer Timer erstellen darf, hat auf dem Server "Server verwalten" oder
# steht im Dashboard unter "Zugang".

# Optional: Rolle, die beim Einfrieren gepingt wird
PING_ROLE_ID=

# Zeitzone, in der Uhrzeiten wie "20:30" verstanden werden
TIMEZONE=Europe/Berlin
